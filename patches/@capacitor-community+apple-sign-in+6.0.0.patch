@@ -1,4 +1,5 @@
 import Foundation
+import UIKit
 import Capacitor
 import AuthenticationServices
 
@@ -19,6 +20,10 @@ public class SignInWithApple: CAPPlugin {
 
         let authorizationController = ASAuthorizationController(authorizationRequests: [request])
         authorizationController.delegate = self
+        // iPad requires a presentation anchor. Without presentationContextProvider
+        // ASAuthorizationController fails on iPad and fires didCompleteWithError.
